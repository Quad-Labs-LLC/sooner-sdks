{
  "name": "sooner-email",
  "version": "0.2.0",
  "description": "Official JavaScript and TypeScript client for the Sooner email API",
  "type": "module",
  "license": "MIT",
  "homepage": "https://sooner.dev/docs/sdks/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quad-Labs-LLC/sooner-sdks.git",
    "directory": "javascript"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./in-app": {
      "types": "./dist/in-app.d.ts",
      "default": "./dist/in-app.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
